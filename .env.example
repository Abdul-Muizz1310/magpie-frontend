# magpie-frontend environment variables
# Copy to .env.local and fill in values

# Backend viewer API URL
NEXT_PUBLIC_API_URL=https://magpie-backend-t4bb.onrender.com

# Admin secret (server-only — NEVER prefix with NEXT_PUBLIC). Gates every
# state-changing Server Action (create/update/delete source, enqueue/sync
# scrape) and doubles as the /login password. If unset or empty, ALL mutations
# are disabled (fail closed) and the app is read-only. Use a long random value.
MAGPIE_ADMIN_SECRET=

# Ed25519 private key (server-only, NEVER NEXT_PUBLIC): PKCS#8 DER, base64, one line. Signs the
# 60 s platform token magpie-backend requires; unset => every backend call fails (503 / error).
MAGPIE_FRONTEND_SIGNING_KEY_PRIVATE=
